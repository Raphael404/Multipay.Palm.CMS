# Base path of the Admin API. Requests go to `${VITE_API_BASE_URL}/merchants`, etc.
# Keep the relative default to use the Vite dev proxy below, or set a full URL
# (e.g. https://api.example.ge/api/v1/admin) if the backend allows CORS.
VITE_API_BASE_URL=/api/v1/admin

# Dev only: backend origin that the Vite dev server proxies `/api` to.
VITE_API_PROXY_TARGET=https://your-backend.example.com
